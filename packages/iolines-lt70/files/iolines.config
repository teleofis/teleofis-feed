config io
	option name "IO1"
	option dev "adc0"
	option source "/sys/bus/iio/devices/iio:device0/in_voltage0_raw"
	option enabled "0"
	option mode "mode1"
	option poll "0"
	option oc_on "echo high > /dev/pd0/direction"
	option oc_off "echo low > /dev/pd0/direction"
	option dc_on "echo high > /dev/pu0/direction"
	option dc_off "echo low > /dev/pu0/direction"

