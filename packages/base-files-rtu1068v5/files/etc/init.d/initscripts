#!/bin/sh /etc/rc.common
# Copyright (C) 2026 teleofis

START=12
STOP=84

start()
{
	# modem init
	echo 124 > /sys/class/gpio/export
	echo high > /sys/class/gpio/gpio124/direction
	echo 118 > /sys/class/gpio/export
	echo high > /sys/class/gpio/gpio118/direction
	echo 117 > /sys/class/gpio/export
	echo in > /sys/class/gpio/gpio117/direction
	echo 120 > /sys/class/gpio/export
	echo in > /sys/class/gpio/gpio120/direction
	echo 116 > /sys/class/gpio/export
	echo low > /sys/class/gpio/gpio116/direction
	echo 122 > /sys/class/gpio/export
	echo low > /sys/class/gpio/gpio122/direction

	# usb host

	# serial 
	ln -s /dev/ttyS1 /dev/com0
	ln -s /dev/ttyS0 /dev/com1
	ln -s /dev/ttyS2 /dev/com2

	# gps
	ln -s /dev/pps0 /dev/gpspps0

}
