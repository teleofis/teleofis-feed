+++ b/board/sunxi/board.c
@@ -29,6 +29,7 @@
 #include <asm/arch/mmc.h>
 #include <asm/arch/prcm.h>
 #include <asm/arch/pmic_bus.h>
+#include <asm/arch/serial.h>
 #include <asm/arch/spl.h>
 #include <asm/arch/sys_proto.h>
 #include <asm/global_data.h>
@@ -975,6 +976,25 @@
 	return 0;
 }
 
+#if CONFIG_CONS_INDEX == 2 && defined(CONFIG_MACH_SUN50I_H616)
+/*
+ * Hand UART1 over to Linux the same way as with the console on UART0:
+ * held in reset, with its bus clock gated. This runs after the last
+ * U-Boot message, so let the transmitter drain first.
+ */
+void board_cleanup_before_linux(void)
+{
+	void *const ccm = (void *)SUNXI_CCM_BASE;
+	void *const lsr = (void *)SUNXI_UART1_BASE + 0x14;
+
+	while (!(readl(lsr) & BIT(6)))		/* LSR.TEMT */
+		;
+
+	clrbits_le32(ccm + CCU_H6_UART_GATE_RESET, 1 << (RESET_SHIFT + 1));
+	clrbits_le32(ccm + CCU_H6_UART_GATE_RESET, 1 << (GATE_SHIFT + 1));
+}
+#endif
+
