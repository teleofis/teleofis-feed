#!/bin/sh /etc/rc.common

START=20
USE_PROCD=1
PROG=/usr/sbin/svcontrol

start_service() {
	[ "$(uci -q get supervisor.main.enabled)" = "0" ] && return 0
	procd_open_instance
	procd_set_param command "$PROG"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger supervisor
}
