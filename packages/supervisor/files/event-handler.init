#!/bin/sh /etc/rc.common

START=11
USE_PROCD=1
PROG=/usr/sbin/event-handler

start_service() {
	. /usr/lib/supervisor/common.sh
	touch "$(sv_cfg events log /etc/event_log)"
	for opt in poe_gpio usb_gpio heat_gpio wd_gpio; do
		gpio="$(uci -q get supervisor.events.$opt)"
		[ -n "$gpio" ] && echo $gpio > /sys/class/gpio/export
	done
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
