+ * @param parity one of the SOFT_UART_PARITY_* modes
+ * @param stop_bits number of stop bits, 1 or 2
+ * @return 1 if the operation is successful. 0 otherwise.
+ */
+int raspberry_soft_uart_set_frame_format(const int data_bits, const int parity, const int stop_bits)
+{
+  unsigned long flags;
+
+  if (data_bits < 5 || data_bits > 8
+    || parity < SOFT_UART_PARITY_NONE || parity > SOFT_UART_PARITY_SPACE
+    || stop_bits < 1 || stop_bits > 2)
+  {
+    return 0;
+  }
+
+  spin_lock_irqsave(&current_tty_lock, flags);
+  format.data_bits = data_bits;
+  format.parity = parity;
+  format.stop_slot = 1 + data_bits + (parity != SOFT_UART_PARITY_NONE ? 1 : 0);
+  format.frame_bits = format.stop_slot + stop_bits;
+  spin_unlock_irqrestore(&current_tty_lock, flags);
+
+  printk(KERN_INFO "soft_uart: frame format = %d%c%d.\n",
+    data_bits, "NEOMS"[parity], stop_bits);
+
   return 1;
 }
 
