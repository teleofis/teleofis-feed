+  reset_poll_stats();
+
+  complete(&poll_ready);
+
+  last_touch = ktime_get_ns();
+  next = last_touch + sample_ns;
+
+  while (!kthread_should_stop())
+  {
+    u64 now = wait_until(next);
+    int level = gpiod_get_raw_value(desc_rx);
+
+    poll_rx_step(now, level);
+    poll_tx_step(now);
+
+    next += sample_ns;
+    if ((s64) (next - now) <= 0)
+    {
+      next = now + sample_ns;
+    }
+
+    if (rx_in_frame || tx_in_frame)
+    {
+      if (!poll_stream_open)
+      {
+        poll_stream_open = true;
+        poll_stream_since = now;
+      }
+
+      poll_stream_last = now;
+      disable_poll_irqs();
+    }
+
+    else if (poll_stream_open
+      && (s64) (now - poll_stream_last) < (s64) ((u64) format.frame_bits * bit_ns)
+      && (s64) (now - poll_stream_since) < (s64) POLL_MAX_STREAM_NS)
+    {
+      busy_since = 0;
+      continue;
+    }
+
+    if (!rx_in_frame && !tx_in_frame)
+    {
+      close_poll_stream(now);
+      busy_since = 0;
+
+      flush_rx_buffer();
+
+      if ((s64) (now - last_touch) > NSEC_PER_SEC)
+      {
+        touch_softlockup_watchdog();
+        last_touch = now;
+      }
+
+      cond_resched();
+      next = ktime_get_ns() + sample_ns;
+    }
+    else if (busy_since == 0)
+    {
+      busy_since = now;
+    }
+    else if ((s64) (now - busy_since) > (s64) POLL_MAX_BUSY_NS)
+    {
+      close_poll_stream(now);
+      flush_rx_buffer();
+      touch_softlockup_watchdog();
+      cond_resched();
+      reset_poll_state();
+      busy_since = 0;
+      last_touch = ktime_get_ns();
+      next = last_touch + sample_ns;
+    }
+  }
+
+  close_poll_stream(ktime_get_ns());
+  flush_rx_buffer();
+  gpiod_set_raw_value(desc_tx, 1);
+  log_poll_stats();
+
+  return 0;
+}
+
+/**
+ * Starts the polling thread on the dedicated CPU.
+ * @return true if the thread is running.
+ */
+static bool start_poll_thread(void)
+{
+  struct task_struct* thread;
+
+  thread = kthread_create(poll_thread_function, NULL, "soft_uart_poll");
+
+  if (IS_ERR(thread))
+  {
+    printk(KERN_ALERT "soft_uart: Failed to create the polling thread.\n");
+    return false;
+  }
+
+  init_completion(&poll_ready);
+  kthread_bind(thread, poll_cpu);
+
+  if (poll_rt)
+  {
+    sched_set_fifo(thread);
+  }
+
+  poll_thread = thread;
+  wake_up_process(thread);
+
+  if (!wait_for_completion_timeout(&poll_ready, msecs_to_jiffies(5000)))
+  {
+    printk(KERN_ALERT "soft_uart: The polling thread did not start on CPU %d.\n",
+      poll_cpu);
+    stop_poll_thread();
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * Stops the polling thread.
+ */
+static void stop_poll_thread(void)
+{
+  if (poll_thread != NULL)
+  {
+    kthread_stop(poll_thread);
+    poll_thread = NULL;
+  }
 }
