 /**
+ * Recomputes the polling time grid for a given baudrate.
+ * @param baudrate given baudrate
+ */
+static void recompute_poll_timing(int baudrate)
+{
+  bit_ns = div_u64(1000000000ULL, (u32) baudrate);
+  samples_per_bit = oversample;
+
+  if (sample_cost_ns > 0)
+  {
+    u64 affordable = div_u64(bit_ns, (u32) (poll_headroom * sample_cost_ns));
+
+    if (affordable < MIN_OVERSAMPLE)
+    {
+      affordable = MIN_OVERSAMPLE;
+    }
+
+    if (samples_per_bit > affordable)
+    {
+      samples_per_bit = (unsigned int) affordable;
+    }
+  }
+
+  sample_ns = div_u64(bit_ns, samples_per_bit);
+}
