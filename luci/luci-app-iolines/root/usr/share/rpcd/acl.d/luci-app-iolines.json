{
	"luci-app-iolines": {
		"description": "Grant UCI access for luci-app-iolines",
		"read": {
			"uci": [ "iolines" ],
			"ubus": {
				"iolines": [ "raw", "voltage", "resist" ],
				"file": [ "exec" ]
			},
			"file": {
				"/sbin/iolinesd -c /var/etc/iolinesd.conf -t": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "iolines" ],
			"ubus": {
				"iolines": [ "voltage" ]
			}
		}
	}
}
